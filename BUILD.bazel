""" Builds rcl.
"""

load("@rules_ros2//ros2:cc_defs.bzl", "ros2_c_library", "ros2_cpp_test")

ros2_c_library(
    name = "rcl_yaml_param_parser",
    srcs = glob([
        "rcl_yaml_param_parser/src/*.c",
        "rcl_yaml_param_parser/src/impl/*.h",
    ]),
    hdrs = glob(["rcl_yaml_param_parser/include/**/*.h"]),
    includes = ["rcl_yaml_param_parser/include"],
    visibility = ["//visibility:public"],
    deps = [
        "@libyaml",
        "@ros2_rcutils//:rcutils",
        "@ros2_rmw//:rmw",
    ],
)

ros2_c_library(
    name = "rcl",
    srcs = glob([
        "rcl/src/rcl/*.c",
        "rcl/src/rcl/*.h",
    ]),
    hdrs = glob(["rcl/include/**/*.h"]),
    includes = ["rcl/include"],
    copts = [
        "-I external/" + repository_name()[1:] + "/rcl/src",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":rcl_yaml_param_parser",
        "@ros2_rcl_interfaces//:c_rcl_interfaces",
        "@ros2_rcl_interfaces//:c_type_description_interfaces",
        "@ros2_rcl_logging//:rcl_logging_spdlog",
        "@ros2_rcutils//:rcutils",
        "@ros2_rmw_implementation//:rmw_implementation",
        "@ros2_rosidl//:rosidl_runtime_c",
        "@ros2_tracing//:tracetools",
    ],
)

# Prototype implementation of Torc's draft REP for pluggable clock sources
# (rep-draft-pluggable-clock-sources.rst, torc-compute-foundation/adr).
# Not part of upstream rcl's own ament/CMake test suite -- wired up here so
# it can be built and run through the same Bazel override toolchain used to
# prototype the rest of this design across rcl/rclcpp/rmw/rmw_fastrtps/Fast-DDS.
ros2_cpp_test(
    name = "test_clock_type_registry",
    size = "small",
    srcs = ["rcl/test/rcl/test_clock_type_registry.cpp"],
    set_up_ament = True,
    deps = [
        ":rcl",
        "@@googletest~//:gtest_main",
    ],
)

ros2_cpp_test(
    name = "test_init_options_clock_source",
    size = "small",
    srcs = ["rcl/test/rcl/test_init_options_clock_source.cpp"],
    set_up_ament = True,
    deps = [
        ":rcl",
        "@@googletest~//:gtest_main",
        "@ros2_rmw//:rmw",
    ],
)

ros2_c_library(
    name = "rcl_action",
    srcs = glob([
        "rcl_action/src/rcl_action/*.c",
        "rcl_action/src/rcl_action/*.h",
    ]),
    hdrs = glob(["rcl_action/include/**/*.h"]),
    includes = ["rcl_action/include"],
    visibility = ["//visibility:public"],
    deps = [
        ":rcl",
        "@ros2_rcl_interfaces//:c_action_msgs",
        "@ros2_rcutils//:rcutils",
        "@ros2_rmw//:rmw",
        "@ros2_rosidl//:rosidl_runtime_c",
    ],
)

ros2_c_library(
    name = "rcl_lifecycle",
    srcs = glob([
        "rcl_lifecycle/src/*.c",
        "rcl_lifecycle/src/*.h",
    ]),
    hdrs = glob(["rcl_lifecycle/include/rcl_lifecycle/*.h"]),
    includes = ["rcl_lifecycle/include"],
    visibility = ["//visibility:public"],
    deps = [
        ":rcl",
        "@ros2_rcl_interfaces//:c_lifecycle_msgs",
    ],
)
